{
    "name": "lufiipe/insee-sierene",
    "type": "library",
    "description": "A PHP package for retrieving company information from the INSEE Sirene API",
    "keywords": [
        "php",
        "insee",
        "sirene",
        "siren",
        "siret"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Luis-Filipe ANTUNES",
            "email": "lf.antunes.dasilva@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "lufiipe/simplevent": "^1.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "LuFiipe\\InseeSierene\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LuFiipe\\InseeSierene\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test:analyse": [
            "./vendor/bin/phpstan"
        ],
        "test:unit": [
            "./vendor/bin/phpunit"
        ],
        "test": [
            "@test:analyse",
            "@test:unit"
        ]
    }
}